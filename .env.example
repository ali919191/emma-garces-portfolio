# Neon PostgreSQL (copy the pooled connection string from the Neon dashboard)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Vercel Blob private store token (created when Blob is connected to the project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Comma-separated allowlist. Only these GitHub account emails may enter the studio.
ADMIN_EMAIL=emma@example.com

# NextAuth / GitHub OAuth
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_GITHUB_ID=replace_with_github_oauth_client_id
AUTH_GITHUB_SECRET=replace_with_github_oauth_client_secret
NEXTAUTH_URL=http://localhost:3000

# Public metadata and canonical URL
SITE_URL=https://emmagarces.com
SITE_TITLE=Emma Garces — International Runway Model
SITE_DESCRIPTION=The official portfolio and international booking profile of runway model Emma Garces.
SOCIAL_IMAGE_PATH=/og.png

# Optional local visual QA only. Both are ignored when NODE_ENV=production.
# PORTFOLIO_DEMO_MODE=true
# AUTH_BYPASS_FOR_LOCAL_TESTS=true
